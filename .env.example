# GEMINI_API_KEY: Required for Gemini AI scrap photo identification.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where Kabadiwala Connect is hosted.
APP_URL="http://localhost:3000"

# Runtime mode and demo persona switcher (never enable DEMO_MODE in production)
NODE_ENV="development"
DEMO_MODE="true"

# Security secrets (replace with strong random 32+ byte hex strings in production)
SESSION_SECRET="dev-session-secret-change-in-production"
RECEIPT_HMAC_SECRET="dev-receipt-hmac-secret-change-in-production"

# SMS OTP provider: console | msg91 | twilio
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Storage provider: local | supabase
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLIC_BUCKET="lot-photos"
SUPABASE_PRIVATE_BUCKET="recycler-docs"

# PostgreSQL / Supabase connection (used when running with Prisma / Postgres deployment)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kabadiwala_connect?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kabadiwala_connect?schema=public"
